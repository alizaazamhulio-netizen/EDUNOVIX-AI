# Required for the existing Gemini learning features
GEMINI_API_KEY=replace_with_your_gemini_server_key

# Set true in production to require a verified Firebase ID token for AI endpoints.
# This must match the Firebase project used by firebase.js.
AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: use a non-default port locally.
# PORT=3000
